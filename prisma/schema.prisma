// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id() @default(uuid())
  clerkId     String     @unique
  name        String
  email       String?     @unique
  password    String?
  lgpdConsent Boolean
  anuncios    Anuncio[]
  conversas   Conversa[] @relation("participantes")
  createdAt   DateTime   @default(now()) @map("created_at")
  anunciosSalvos AnuncioSalvo[] 
  updatedAt   DateTime?  @updatedAt @map("updated_at")
  Mensagem    Mensagem[]

  @@map("users")
}

model Anuncio {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo         String          @db.VarChar(50)
  descricao      String          @db.VarChar(200)
  tags           Json
  lat            Float
  lng            Float
  bairro         String          @db.VarChar(50)
  cidade         String          @db.VarChar(50)
  estado         String          @db.VarChar(50)
  cep            String          @db.VarChar(50)
  pais           String          @db.VarChar(50)
  fotos          FotoAnuncio[]
  conversas      Conversa[]
  salvoPor       AnuncioSalvo[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime?       @updatedAt @map("updated_at")
  expiresAt      DateTime        @map("expires_at")
  deletedAt      DateTime?       @map("deleted_at")
  motivoExclusao MotivoExclusao? @map("motivo_exclusao")

  @@map("anuncios")
}

enum MotivoExclusao {
  TROQUEI_PELA_TROKE
  DOEI_PELA_TROKE
  DESAPEGUEI_POR_OUTRO_MEIO
  DESISTI_DE_DESAPEGAR
  OUTRO_MOTIVO

  @@map("motivos_exclusao")
}

model FotoAnuncio {
  id        String  @id @default(uuid())
  key       String  @unique
  anuncioId String
  anuncio   Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)

  @@map("fotos_anuncios")
}

model AnuncioSalvo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anuncioId String
  anuncio   Anuncio  @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, anuncioId])
  @@map("anuncios_salvos")
}

enum StatusConversa {
  ATIVA
  ENCERRADA

  @@map("status_conversa")
}

model Conversa {
  id            String         @id @default(uuid())
  anuncioId     String
  anuncio       Anuncio        @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  // Relação com os participantes da conversa
  participantes User[]         @relation("participantes")
  mensagens     Mensagem[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  status        StatusConversa @default(ATIVA)

  @@map("conversas")
}

model Mensagem {
  id          String    @id @default(uuid())
  conteudo    String    @db.Text
  conversaId  String
  conversa    Conversa  @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  remetenteId String
  remetente   User      @relation(fields: [remetenteId], references: [id])
  lidoEm      DateTime? @map("lido_em")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("mensagens")
}
